<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Oilfield Equipment Guide — دليل معدات النفط</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;900&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --primary:#1a365d; --secondary:#2b6cb0; --accent:#e53e3e;
    --bg:#f7fafc; --bg-alt:#edf2f7; --card:#ffffff;
    --text:#2d3748; --text-soft:#718096; --border:#e2e8f0; --line:#cbd5e0;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{background:var(--bg);color:var(--text);font-family:'Tajawal','Inter',sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased;}
  html[dir="ltr"] body{font-family:'Inter','Tajawal',sans-serif;}
  .wrap{max-width:860px;margin:0 auto;padding:0 20px 90px;}
  .view{display:none;} .view.active{display:block;}

  .topbar{display:flex;align-items:center;justify-content:space-between;padding:18px 0;border-bottom:1px solid var(--border);margin-bottom:24px;}
  .brand{font-weight:800;color:var(--primary);font-size:15px;letter-spacing:.2px;}
  .lang-btn{border:1.5px solid var(--secondary);color:var(--secondary);background:var(--card);font-family:inherit;font-weight:700;font-size:13px;padding:8px 16px;border-radius:6px;cursor:pointer;transition:.15s;}
  .lang-btn:hover{background:var(--secondary);color:#fff;}

  .hero h1{font-size:clamp(30px,6vw,46px);font-weight:800;line-height:1.15;color:var(--primary);margin-bottom:18px;}
  .hero h1 span{color:var(--secondary);display:block;}
  .hero p.lead{font-size:15.5px;color:var(--text-soft);max-width:540px;margin-bottom:22px;}
  .search{display:flex;align-items:center;gap:10px;border:1.5px solid var(--line);border-radius:8px;padding:12px 16px;margin-bottom:32px;background:var(--card);}
  .search input{flex:1;border:none;background:transparent;outline:none;font-family:inherit;font-size:15px;color:var(--text);}
  .search input::placeholder{color:var(--text-soft);}
  .search svg{flex-shrink:0;stroke:var(--text-soft);}

  .cat-header{font-size:13px;font-weight:800;color:var(--secondary);letter-spacing:.4px;margin:34px 0 14px;padding-bottom:8px;border-bottom:2px solid var(--border);}
  .eq-list{border-top:1px solid var(--border);}
  .eq-row{border-bottom:1px solid var(--border);padding:22px 4px;cursor:pointer;transition:background .15s;display:flex;gap:16px;align-items:flex-start;}
  .eq-row:hover{background:var(--bg-alt);}
  .eq-num{color:var(--accent);font-size:13px;font-weight:800;min-width:26px;padding-top:4px;}
  .eq-icon{width:46px;height:46px;flex-shrink:0;border:1.5px solid var(--secondary);border-radius:8px;display:flex;align-items:center;justify-content:center;background:var(--bg-alt);}
  .eq-icon svg{width:22px;height:22px;stroke:var(--secondary);}
  .eq-body{flex:1;min-width:0;}
  .eq-title{font-size:19px;font-weight:800;color:var(--primary);}
  .eq-en{font-size:12px;color:var(--text-soft);letter-spacing:.4px;margin:2px 0 6px;font-family:'Inter',sans-serif;}
  .eq-desc{font-size:13.5px;color:var(--text-soft);}
  .eq-arrow{align-self:center;color:var(--secondary);flex-shrink:0;}
  .eq-arrow svg{width:16px;height:16px;stroke:var(--secondary);}

  .back{display:inline-flex;align-items:center;gap:8px;color:var(--secondary);font-weight:700;font-size:14px;margin-bottom:22px;cursor:pointer;background:none;border:none;font-family:inherit;}
  .back svg{width:15px;height:15px;stroke:var(--secondary);}
  html[dir="ltr"] .back svg{transform:scaleX(-1);}

  .detail-tag{color:var(--accent);font-size:13px;font-weight:800;margin-bottom:8px;}
  .detail-title{font-size:clamp(26px,5.5vw,38px);font-weight:800;line-height:1.15;color:var(--primary);}
  .detail-en{color:var(--text-soft);font-size:13px;font-family:'Inter',sans-serif;letter-spacing:.4px;margin-top:6px;}

  .photo-block{margin:20px 0 30px;border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--card);}
  .photo-block img{width:100%;display:block;aspect-ratio:16/10;object-fit:cover;}
  .photo-cap{display:flex;justify-content:space-between;padding:9px 14px;font-size:11.5px;color:var(--text-soft);background:var(--bg-alt);}

  .sect-label{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:800;color:var(--primary);letter-spacing:.3px;margin:34px 0 14px;}
  .sect-label .rule{flex:1;height:1px;background:var(--border);}
  .hint{font-size:13px;color:var(--text-soft);margin-bottom:14px;line-height:1.6;}

  .maint-list{list-style:none;}
  .maint-list li{display:flex;gap:12px;align-items:flex-start;justify-content:space-between;padding:13px 0;border-bottom:1px solid var(--border);font-size:14.5px;}
  .maint-list li:last-child{border-bottom:none;}
  .maint-body{display:flex;gap:12px;align-items:flex-start;flex:1;min-width:0;}
  .maint-list .dot{flex-shrink:0;width:8px;height:8px;border-radius:50%;background:var(--secondary);margin-top:7px;}
  .maint-freq{color:var(--text-soft);font-size:12px;display:block;margin-top:2px;}
  .part-link{flex-shrink:0;border:1px solid var(--secondary);background:none;color:var(--secondary);font-family:inherit;font-size:12px;font-weight:600;padding:6px 11px;border-radius:6px;cursor:pointer;white-space:nowrap;display:inline-flex;align-items:center;gap:5px;margin-top:1px;transition:.15s;}
  .part-link:hover{background:var(--secondary);color:#fff;}
  .part-link:hover svg{stroke:#fff;}
  .part-link svg{width:12px;height:12px;stroke:var(--secondary);}

  .legend-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:16px;}
  .legend-chip{display:flex;align-items:center;gap:9px;border:1px solid var(--border);background:var(--card);padding:10px 12px;border-radius:8px;font-size:13px;cursor:pointer;transition:.15s;}
  .legend-chip:hover{border-color:var(--secondary);}
  .legend-chip.active{border-color:var(--secondary);background:#ebf4fd;}
  .legend-chip .num{flex-shrink:0;width:20px;height:20px;border-radius:50%;background:var(--secondary);color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;}
  @media(max-width:480px){.legend-grid{grid-template-columns:1fr;}}

  .diagram-wrap{position:relative;width:100%;aspect-ratio:400/260;border:1px solid var(--border);border-radius:10px;background:var(--card);margin-bottom:16px;overflow:hidden;}
  .diagram-wrap svg.scene{width:100%;height:100%;display:block;}
  .hotspot{position:absolute;width:26px;height:26px;margin:-13px 0 0 -13px;border-radius:50%;background:var(--secondary);color:#fff;border:2px solid var(--card);font-weight:700;font-size:12px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-family:inherit;box-shadow:0 0 0 3px rgba(43,108,176,.18);transition:.15s;}
  .hotspot:hover{transform:scale(1.12);}
  .hotspot.active{background:var(--primary);box-shadow:0 0 0 3px rgba(26,54,93,.25);}
  .hotspot.fmark{background:var(--accent);box-shadow:0 0 0 4px rgba(229,62,62,.22);animation:pulseRed 1.8s infinite;}
  .hotspot.fmark.sel{outline:3px solid var(--primary);}
  @keyframes pulseRed{0%{box-shadow:0 0 0 0 rgba(229,62,62,.5);}70%{box-shadow:0 0 0 11px rgba(229,62,62,0);}100%{box-shadow:0 0 0 0 rgba(229,62,62,0);}}

  .hs-panel{border:1px solid var(--border);background:var(--card);border-radius:10px;padding:20px;min-height:120px;}
  .hs-panel .ph{color:var(--text-soft);font-size:14px;}
  .hs-part-name{font-size:18px;font-weight:800;margin-bottom:10px;color:var(--primary);}
  .hs-row{font-size:14px;margin-bottom:6px;}
  .hs-row b{font-weight:700;}
  .hs-row.fault b{color:var(--accent);}

  .fault-card{border:1px solid var(--border);background:var(--card);border-radius:10px;padding:18px;margin-bottom:12px;cursor:pointer;transition:.15s;}
  .fault-card:hover{border-color:var(--accent);}
  .fault-name{font-size:15.5px;font-weight:800;color:var(--accent);margin-bottom:9px;}
  .fault-row{font-size:13.5px;margin-bottom:5px;}
  .fault-row b{color:var(--text);font-weight:700;}
  .fault-row:last-child{margin-bottom:0;}
  .sev-pill{display:inline-block;padding:2px 10px;font-size:10.5px;font-weight:800;border-radius:20px;margin-inline-start:8px;vertical-align:middle;}
  .sev-urgent{background:#fed7d7;color:#c53030;}
  .sev-watch{background:#feebc8;color:#b7791f;}
  .sev-routine{background:#c6f6d5;color:#2f855a;}

  .exp-grid{display:grid;grid-template-columns:1fr;gap:14px;margin-top:4px;}
  .exp-card{border:1.5px solid var(--secondary);border-radius:10px;padding:22px 20px;cursor:pointer;background:var(--card);transition:.15s;}
  .exp-card:hover{background:#ebf4fd;}
  .exp-card.exp-red{border-color:var(--accent);}
  .exp-card.exp-red:hover{background:#fff5f5;}
  .exp-kicker{font-size:12px;color:var(--accent);font-weight:800;margin-bottom:9px;letter-spacing:.3px;}
  .exp-card:not(.exp-red) .exp-kicker{color:var(--secondary);}
  .exp-title{font-size:19px;font-weight:800;margin-bottom:7px;color:var(--primary);}
  .exp-desc{font-size:13.5px;color:var(--text-soft);margin-bottom:13px;}
  .exp-cta{color:var(--secondary);font-weight:700;font-size:13.5px;display:inline-flex;align-items:center;gap:7px;}
  .exp-card.exp-red .exp-cta{color:var(--accent);}
  .exp-cta svg{width:13px;height:13px;stroke:currentColor;}
  html[dir="rtl"] .exp-cta svg, html[dir="rtl"] .eq-arrow svg{transform:scaleX(-1);}

  footer{text-align:center;font-size:12px;color:var(--text-soft);margin-top:60px;padding-top:20px;border-top:1px solid var(--border);}
</style>
</head>
<body>
<div class="wrap">

  <div class="topbar">
    <span class="brand" id="brandLabel"></span>
    <button class="lang-btn" id="langToggleBtn" onclick="setLang(LANG==='ar'?'en':'ar')"></button>
  </div>

  <!-- ============ HOME ============ -->
  <section id="view-home" class="view active">
    <div class="hero">
      <h1 id="heroTitle1"></h1>
      <h1><span id="heroTitle2"></span></h1>
      <p class="lead" id="leadText"></p>
      <div class="search">
        <input id="searchInput" type="text">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </div>
    </div>
    <div class="cat-header" id="catGeneralLabel"></div>
    <div class="eq-list" id="eqListGeneral"></div>
    <div class="cat-header" id="catFieldLabel"></div>
    <div class="eq-list" id="eqListField"></div>
  </section>

  <!-- ============ DETAIL ============ -->
  <section id="view-detail" class="view">
    <button class="back" data-go="home"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg><span id="backHomeLabel"></span></button>
    <div class="detail-tag" id="d-tag"></div>
    <div class="detail-title" id="d-title"></div>
    <div class="detail-en" id="d-en"></div>

    <div class="photo-block"><img id="d-img" src="" alt=""><div class="photo-cap"><span id="d-cap"></span><span>Wikimedia Commons</span></div></div>

    <p class="hint" id="d-desc" style="font-size:15px;color:var(--text)"></p>

    <div class="sect-label"><span id="diagramSectionLabel"></span><span class="rule"></span></div>
    <p class="hint" id="diagramHintText"></p>
    <div class="diagram-wrap" id="d-diagram"></div>
    <div class="legend-grid" id="d-legend"></div>
    <div class="hs-panel" id="d-panel"></div>

    <div class="sect-label"><span id="maintSectionLabel"></span><span class="rule"></span></div>
    <ul class="maint-list" id="d-maint"></ul>

    <div class="sect-label"><span id="faultsSectionLabel"></span><span class="rule"></span></div>
    <div id="d-faults"></div>

    <div class="sect-label"><span id="tryYourselfLabel"></span><span class="rule"></span></div>
    <div class="exp-grid">
      <div class="exp-card exp-red" data-go="exp1">
        <div class="exp-kicker" id="exp1KickerLabel"></div>
        <div class="exp-title" id="exp1TitleLabel"></div>
        <div class="exp-desc" id="exp1DescLabel"></div>
        <span class="exp-cta"><span id="exp1CtaLabel"></span><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg></span>
      </div>
      <div class="exp-card" data-go="exp2">
        <div class="exp-kicker" id="exp2KickerLabel"></div>
        <div class="exp-title" id="exp2TitleLabel"></div>
        <div class="exp-desc" id="exp2DescLabel"></div>
        <span class="exp-cta"><span id="exp2CtaLabel"></span><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg></span>
      </div>
    </div>
  </section>

  <!-- ============ EXP 1: FAULT MAP ============ -->
  <section id="view-exp1" class="view">
    <button class="back" data-go="detail"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg><span id="backDetailLabel1"></span></button>
    <div class="detail-tag" id="e1-tag"></div>
    <div class="detail-title" style="font-size:26px;margin-bottom:14px;" id="e1-title"></div>
    <p class="hint" id="e1-hint"></p>
    <div class="diagram-wrap" id="e1-diagram"></div>
    <div id="e1-list"></div>
  </section>

  <!-- ============ EXP 2: PARTS EXPLORER ============ -->
  <section id="view-exp2" class="view">
    <button class="back" data-go="detail"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg><span id="backDetailLabel2"></span></button>
    <div class="detail-tag" id="e2-tag"></div>
    <div class="detail-title" style="font-size:26px;margin-bottom:14px;" id="e2-title"></div>
    <p class="hint" id="e2-hint"></p>
    <div class="diagram-wrap" id="e2-diagram"></div>
    <div class="legend-grid" id="e2-legend"></div>
    <div class="hs-panel" id="e2-panel"></div>
  </section>

  <footer id="footerLabel"></footer>
</div>

<script>
/* ============================================================
   LANGUAGE HELPERS
   ============================================================ */
let LANG = 'ar';
function L(pair){ return pair[LANG==='ar'?0:1]; }

const UI = {
  brand: ['دليل معدات النفط','Oilfield Equipment Guide'],
  heroTitle1: ['من الحفر','From Drilling'],
  heroTitle2: ['إلى التكرير.','To Refining.'],
  lead: ['مرجع تطبيقي لمعدات صناعة النفط والغاز — افتح أي معدة وشوف صيانتها وخارطة أعطالها وأجزاءها بالتفصيل.','A hands-on reference for oil & gas equipment — open any unit to see its maintenance, fault map, and labeled parts.'],
  searchPlaceholder: ['دور على معدة...','Search equipment...'],
  catGeneral: ['المعدات العامة','General Components'],
  catField: ['منظومات الحقل والتكرير','Field & Refining Systems'],
  backHome: ['رجوع لكل المعدات','Back to all equipment'],
  backDetail: ['رجوع لصفحة المعدة','Back to equipment page'],
  diagramSection: ['الرسم الهندسي للمعدة','Engineering Diagram'],
  diagramHint: ['اضغط على أي رقم بالرسم أو أي اسم بالقائمة تحته لتعرف وظيفته وعطله الشائع — أو اضغط زر "شوف الجزء" جنب أي خطوة صيانة تحت.','Click any number on the diagram or its name below to see its function and common fault — or click "View Part" next to a maintenance step below.'],
  maintSection: ['الصيانة الدورية','Routine Maintenance'],
  faultsSection: ['الأعطال الشائعة','Common Faults'],
  tryYourself: ['جرّب بنفسك','Try It Yourself'],
  exp1Kicker: ['التجربة ١ — خارطة أعطال هندسية','Experience 1 — Engineering Fault Map'],
  exp1Title: ['خارطة الأعطال','Fault Map'],
  exp1Desc: ['رسم مفصل للمعدة مع كل أعطالها الشائعة مؤشرة عليه مباشرة باللون الأحمر — اضغط على أي نقطة أو اسم عطل وشوف سببه وطريقة إصلاحه فوراً، بدون أسئلة.','A detailed diagram with every common fault marked directly in red — click any point or fault name to see its cause and fix instantly, no questions asked.'],
  exp1Cta: ['افتح خارطة الأعطال','Open Fault Map'],
  exp2Kicker: ['التجربة ٢ — استكشاف هندسي','Experience 2 — Engineering Exploration'],
  exp2Title: ['استكشف الأجزاء','Explore the Parts'],
  exp2Desc: ['افتح المخطط الهندسي واضغط على كل جزء حتى تتعرف عليه ووظيفته وعطله الشائع.','Open the engineering diagram and click each part to learn what it is, its function, and its common fault.'],
  exp2Cta: ['افتح المخطط','Open Diagram'],
  clickHintFault: ['اضغط على أي نقطة حمراء أو اسم عطل من القائمة تحت.','Click any red point or fault name in the list below.'],
  causeLabel: ['السبب','Cause'],
  fixLabel: ['الإصلاح','Fix'],
  funcLabel: ['الوظيفة','Function'],
  faultLabel: ['العطل الشائع','Common Fault'],
  diagramPanelDefault: ['اضغط على أي جزء بالرسم أو بالقائمة حتى يبان اسمه وشرحه هنا.','Click a part on the diagram or list to see its details here.'],
  severityUrgent: ['خطر — إيقاف وفحص فوري','Critical — stop & inspect now'],
  severityWatch: ['يحتاج فحص قريب','Needs inspection soon'],
  severityRoutine: ['صيانة روتينية','Routine maintenance'],
  footer: ['دليل معدات النفط — من الحفر إلى التكرير، صيانة وتشخيص تطبيقي','Oilfield Equipment Guide — from drilling to refining, hands-on maintenance & diagnostics'],
  langToggle: ['English','عربي']
};

function applyStaticText(){
  document.getElementById('brandLabel').textContent = L(UI.brand);
  document.getElementById('langToggleBtn').textContent = L(UI.langToggle);
  document.getElementById('heroTitle1').textContent = L(UI.heroTitle1);
  document.getElementById('heroTitle2').textContent = L(UI.heroTitle2);
  document.getElementById('leadText').textContent = L(UI.lead);
  document.getElementById('searchInput').placeholder = L(UI.searchPlaceholder);
  document.getElementById('catGeneralLabel').textContent = L(UI.catGeneral);
  document.getElementById('catFieldLabel').textContent = L(UI.catField);
  document.getElementById('backHomeLabel').textContent = L(UI.backHome);
  document.getElementById('backDetailLabel1').textContent = L(UI.backDetail);
  document.getElementById('backDetailLabel2').textContent = L(UI.backDetail);
  document.getElementById('diagramSectionLabel').textContent = L(UI.diagramSection);
  document.getElementById('diagramHintText').textContent = L(UI.diagramHint);
  document.getElementById('maintSectionLabel').textContent = L(UI.maintSection);
  document.getElementById('faultsSectionLabel').textContent = L(UI.faultsSection);
  document.getElementById('tryYourselfLabel').textContent = L(UI.tryYourself);
  document.getElementById('exp1KickerLabel').textContent = L(UI.exp1Kicker);
  document.getElementById('exp1TitleLabel').textContent = L(UI.exp1Title);
  document.getElementById('exp1DescLabel').textContent = L(UI.exp1Desc);
  document.getElementById('exp1CtaLabel').textContent = L(UI.exp1Cta);
  document.getElementById('exp2KickerLabel').textContent = L(UI.exp2Kicker);
  document.getElementById('exp2TitleLabel').textContent = L(UI.exp2Title);
  document.getElementById('exp2DescLabel').textContent = L(UI.exp2Desc);
  document.getElementById('exp2CtaLabel').textContent = L(UI.exp2Cta);
  document.getElementById('footerLabel').textContent = L(UI.footer);
}

function setLang(l){
  LANG = l;
  document.documentElement.lang = l;
  document.documentElement.dir = l==='ar' ? 'rtl' : 'ltr';
  applyStaticText();
  rerenderCurrent();
}

/* ============================================================
   ICONS
   ============================================================ */
const ICONS = {
