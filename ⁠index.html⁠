  compressor: '<path d="M3 10h6l3-3 3 3h6"/><rect x="4" y="10" width="16" height="7" rx="1"/><path d="M8 21l1-4M16 21l-1-4"/>',
  heater: '<path d="M12 3c2 3-2 4 0 7s-2 4 0 7"/><path d="M4 21h16"/><path d="M6 21V10h12v11"/>',
  motor: '<rect x="3" y="8" width="12" height="8" rx="1"/><circle cx="19" cy="12" r="4"/><path d="M15 10v4"/>',
  rig: '<path d="M12 2L4 21M12 2l8 19M8 21h8"/>',
  mud: '<path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/>',
