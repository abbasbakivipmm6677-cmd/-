const ORDER_GENERAL = ['pump','valve','separator','compressor','heater','motor'];
const ORDER_FIELD = ['rig','mud','downhole','lift','wellhead','cdu','vdu','fcc','hx','sru','tank'];

/* ============================================================
   STATE + VIEW SWITCHING
   ============================================================ */
let STATE = {screen:'home', key:null};
let selectDetailPart = null;

function showView(id){
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  window.scrollTo({top:0, behavior:'instant'});
}

function rerenderCurrent(){
  if(STATE.screen==='home') renderHome(document.getElementById('searchInput').value.trim());
  else if(STATE.screen==='detail') openDetail(STATE.key);
  else if(STATE.screen==='exp1') openExp1(STATE.key);
  else if(STATE.screen==='exp2') openExp2(STATE.key);
}

document.querySelectorAll('[data-go]').forEach(el=>{
  el.addEventListener('click', ()=>{
    const target = el.dataset.go;
    if(target==='home'){ STATE={screen:'home',key:null}; renderHome(''); document.getElementById('searchInput').value=''; showView('view-home'); }
    if(target==='detail') openDetail(STATE.key);
    if(target==='exp1') openExp1(STATE.key);
    if(target==='exp2') openExp2(STATE.key);
  });
});

/* ============================================================
   HOME LIST
   ============================================================ */
function renderRows(container, order, filter, startNum){
  container.innerHTML = '';
  let n = startNum;
  order.forEach(key=>{
    const d = DATA[key];
    const title = L(d.title);
    if(filter && !(title.toLowerCase().includes(filter.toLowerCase()) || d.title[0].includes(filter) || d.title[1].toLowerCase().includes(filter.toLowerCase()))) return;
    const altTitle = d.title[LANG==='ar'?1:0];
    const row = document.createElement('div');
    row.className = 'eq-row';
    row.innerHTML = `
      <div class="eq-num">${String(n).padStart(2,'0')}</div>
      <div class="eq-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${ICONS[d.icon]}</svg></div>
      <div class="eq-body">
        <div class="eq-title">${title}</div>
        <div class="eq-en">${altTitle}</div>
        <div class="eq-desc">${L(d.desc)}</div>
      </div>
      <div class="eq-arrow"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg></div>`;
    row.addEventListener('click', ()=>openDetail(key));
    container.appendChild(row);
    n++;
  });
}
function renderHome(filter){
  renderRows(document.getElementById('eqListGeneral'), ORDER_GENERAL, filter, 1);
  renderRows(document.getElementById('eqListField'), ORDER_FIELD, filter, 1);
}
document.getElementById('searchInput').addEventListener('input', e=>renderHome(e.target.value.trim()));

/* ============================================================
   SHARED DIAGRAM MOUNTING (parts explorer style: name+function+fault)
   ============================================================ */
function mountDiagram(key, diagramId, legendId, panelId){
  const d = DATA[key];
  const dg = document.getElementById(diagramId);
  const legend = legendId ? document.getElementById(legendId) : null;
  const panel = document.getElementById(panelId);
  dg.innerHTML = SCENES[key];
  const dots = [];

  function selectPart(idx){
    dots.forEach(x=>x.classList.remove('active'));
    if(dots[idx]) dots[idx].classList.add('active');
    if(legend){
      legend.querySelectorAll('.legend-chip').forEach(c=>c.classList.remove('active'));
      const chip = legend.querySelector('[data-part="'+idx+'"]');
      if(chip) chip.classList.add('active');
    }
    const h = d.hotspots[idx];
    const f = d.faults[h.ref];
    panel.innerHTML = `
      <div class="hs-part-name">${idx+1}. ${L(h.n)}</div>
      <div class="hs-row"><b>${L(UI.funcLabel)}:</b> ${L(h.fn)}</div>
      <div class="hs-row fault"><b>${L(UI.faultLabel)}:</b> ${L(f.n)}</div>
      <div class="hs-row"><b>${L(UI.fixLabel)}:</b> ${L(f.fx)}</div>`;
  }

  d.hotspots.forEach((h,idx)=>{
    const btn = document.createElement('div');
    btn.className = 'hotspot';
    btn.style.left = (h.x/400*100)+'%'; btn.style.top = (h.y/260*100)+'%';
    btn.textContent = idx+1;
    btn.addEventListener('click', ()=>selectPart(idx));
    dg.appendChild(btn); dots.push(btn);
  });

  if(legend){
    legend.innerHTML = d.hotspots.map((h,idx)=>`<div class="legend-chip" data-part="${idx}"><span class="num">${idx+1}</span><span>${L(h.n)}</span></div>`).join('');
    legend.querySelectorAll('.legend-chip').forEach(chip=>chip.addEventListener('click', ()=>selectPart(parseInt(chip.dataset.part,10))));
  }

  panel.innerHTML = `<span class="ph">${L(UI.diagramPanelDefault)}</span>`;
  return selectPart;
}

/* ============================================================
   DETAIL VIEW
   ============================================================ */
function openDetail(key){
  STATE = {screen:'detail', key};
  const d = DATA[key];
  const order = d.cat==='general' ? ORDER_GENERAL : ORDER_FIELD;
  const i = order.indexOf(key);
  document.getElementById('d-tag').textContent = String(i+1).padStart(2,'0') + ' / ' + d.title[1];
  document.getElementById('d-title').textContent = L(d.title);
  document.getElementById('d-en').textContent = d.title[LANG==='ar'?1:0];
  document.getElementById('d-img').src = d.img;
  document.getElementById('d-img').alt = L(d.title);
  document.getElementById('d-cap').textContent = L(d.cap);
  document.getElementById('d-desc').textContent = L(d.desc);

  document.getElementById('d-maint').innerHTML = d.maint.map(m=>`
    <li>
      <div class="maint-body"><span class="dot"></span><span>${L(m.t)}<span class="maint-freq">${L(m.f)}</span></span></div>
      <button class="part-link" data-part="${m.part}">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"></path></svg>
        ${LANG==='ar'?'شوف الجزء':'View Part'}
      </button>
    </li>`).join('');
  document.querySelectorAll('#d-maint .part-link').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const idx = parseInt(btn.dataset.part, 10);
      if(selectDetailPart) selectDetailPart(idx);
      document.getElementById('d-diagram').scrollIntoView({behavior:'smooth', block:'center'});
    });
  });

  document.getElementById('d-faults').innerHTML = d.faults.map(f=>`
    <div class="fault-card" style="cursor:default;">
      <div class="fault-name">${L(f.n)}</div>
      <div class="fault-row"><b>${L(UI.causeLabel)}:</b> ${L(f.c)}</div>
      <div class="fault-row"><b>${L(UI.fixLabel)}:</b> ${L(f.fx)}</div>
    </div>`).join('');

  selectDetailPart = mountDiagram(key, 'd-diagram', 'd-legend', 'd-panel');
  showView('view-detail');
}

/* ============================================================
   EXPERIENCE 1 — ENGINEERING FAULT MAP (no quiz, all faults shown)
   ============================================================ */
function mountFaultMap(key){
  const d = DATA[key];
  const dg = document.getElementById('e1-diagram');
  dg.innerHTML = SCENES[key];
  const markers = [];

  const list = document.getElementById('e1-list');
  list.innerHTML = d.faultPoints.map((fp,idx)=>{
    const f = d.faults[fp.ref];
    const sevLabel = fp.sev==='urgent'?L(UI.severityUrgent):fp.sev==='watch'?L(UI.severityWatch):L(UI.severityRoutine);
    return `<div class="fault-card" data-idx="${idx}">
      <div class="fault-name">${idx+1}. ${L(f.n)} <span class="sev-pill sev-${fp.sev}">${sevLabel}</span></div>
      <div class="fault-row"><b>${L(UI.causeLabel)}:</b> ${L(f.c)}</div>
      <div class="fault-row"><b>${L(UI.fixLabel)}:</b> ${L(f.fx)}</div>
    </div>`;
  }).join('');

  function selectFault(idx){
    markers.forEach(m=>m.classList.remove('sel'));
    if(markers[idx]) markers[idx].classList.add('sel');
    list.querySelectorAll('.fault-card').forEach(c=>c.style.boxShadow='');
    const card = list.querySelector('[data-idx="'+idx+'"]');
    if(card){ card.style.boxShadow='0 0 0 2px var(--primary) inset'; card.scrollIntoView({behavior:'smooth', block:'nearest'}); }
  }

  d.faultPoints.forEach((fp,idx)=>{
    const b = document.createElement('div');
    b.className = 'hotspot fmark';
    b.style.left = (fp.x/400*100)+'%'; b.style.top = (fp.y/260*100)+'%';
    b.textContent = idx+1;
    b.addEventListener('click', ()=>selectFault(idx));
    dg.appendChild(b); markers.push(b);
  });

  list.querySelectorAll('.fault-card').forEach(card=>{
    card.addEventListener('click', ()=>selectFault(parseInt(card.dataset.idx,10)));
  });
}
function openExp1(key){
  STATE = {screen:'exp1', key};
  const d = DATA[key];
  document.getElementById('e1-tag').textContent = L(UI.exp1Kicker);
  document.getElementById('e1-title').textContent = L(UI.exp1Title) + ' — ' + L(d.title);
  document.getElementById('e1-hint').textContent = L(UI.clickHintFault);
  mountFaultMap(key);
  showView('view-exp1');
}

/* ============================================================
   EXPERIENCE 2 — PARTS EXPLORER
   ============================================================ */
function openExp2(key){
  STATE = {screen:'exp2', key};
  const d = DATA[key];
  document.getElementById('e2-tag').textContent = L(UI.exp2Kicker);
  document.getElementById('e2-title').textContent = L(UI.exp2Title) + ' — ' + L(d.title);
  document.getElementById('e2-hint').textContent = L(UI.diagramHint);
  mountDiagram(key, 'e2-diagram', 'e2-legend', 'e2-panel');
  showView('view-exp2');
}

/* ============================================================
   INIT
   ============================================================ */
applyStaticText();
renderHome('');
</script>
